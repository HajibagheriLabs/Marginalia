# Marginalia — environment
#
# Copy to .env.local and fill in. Every variable here is validated by
# src/lib/env.ts at boot; a missing or malformed value stops the process
# immediately rather than failing on the first request that needs it.

# --- Database -----------------------------------------------------------
# PostgreSQL (Neon). Holds documents, pages, chunk text, the lexical tsvector,
# conversations, messages, citations, retrieval traces, and job state.
# Use the POOLED connection string on serverless.
DATABASE_URL=postgresql://user:password@host.neon.tech/marginalia?sslmode=require

# --- Auth ---------------------------------------------------------------
# Better Auth, email + password. Generate the secret with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Public origin of the app. Inlined into the browser bundle at build time.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- File storage -------------------------------------------------------
# Vercel Blob. Documents are uploaded CLIENT-SIDE with a short-lived token
# minted from this one; file bytes never pass through an API route on the way
# IN, because a Vercel function has a hard 4.5 MB request body limit.
#
# They DO on the way out. The store is configured for PRIVATE access, so a blob
# is not readable from its URL alone and a document is served back through
# /api/documents/[documentId]/file — same origin, same ownership check, and an
# `attachment` content-disposition so nothing a stranger uploaded is ever
# rendered as a top-level document.
BLOB_READ_WRITE_TOKEN=

# An origin serving document files INSTEAD of Vercel Blob. Leave this unset.
#
# It exists for the end-to-end suite, which serves a real PDF from a local HTTP
# server so the browser can fetch it through the real route without a Blob
# token — a secret CI does not have and should not need. Playwright sets it;
# nothing else should. Same rule as OPENROUTER_BASE_URL below: an override, not
# an `if (isTest)`.
# BLOB_FIXTURE_ORIGIN=

# --- Vector store -------------------------------------------------------
# Qdrant Cloud. One collection, cosine distance, dimension taken from the
# embedding config. Payload indexes on user_id and document_id.
QDRANT_URL=https://xxxxxxxx.us-east.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=marginalia_chunks

# --- Model gateway ------------------------------------------------------
# OpenRouter, called through the Vercel AI SDK.
#
# EVERY model id here MUST end in `:free`. The app is validated at boot and
# refuses to start otherwise: a paid slug costs money the moment it is called,
# and this project runs with no card on file.
#
# The live free list: https://openrouter.ai/models?max_price=0
# or: curl -s https://openrouter.ai/api/v1/models | jq -r '.data[].id | select(endswith(":free"))'
#
# Free models are DELISTED WITHOUT NOTICE and share a pool limited to roughly
# 20 requests/minute and — measured from OpenRouter's own 429 body — 50/day on
# an account with no purchased credits. That is why there is a fallback list:
# on a 404, 429, or 5xx the next id is tried, and the model that actually
# served the answer is recorded on the message row.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Free models are delisted without notice and the free DAILY allowance is 50
# requests for an account with no purchased credits (1000 with), shared across
# every model — so the pool is an ordered list, not one id.
#
# Comma-separated, tried in order. Leave blank to use the built-in defaults.
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free

# --- Retrieval ----------------------------------------------------------
# Reranking: `off` or `local`. ON by default, because the eval harness measured
# it: recall@5 86.8% -> 92.1%, MRR 0.736 -> 0.788, at +2.1 s of p50 retrieval
# latency. Reproduce with `npm run eval -- --compare baseline-retrieval rerank-on`.
#
# `local` runs a cross-encoder in this process over the top ~20 fused
# candidates. Cross-encoders are slow — they score every (query, passage) pair
# through a full transformer — so the candidate set is deliberately small.
# Set to `off` on a machine where the extra two seconds matter more than the
# ordering; the app is required to work either way.
#
# `openrouter` is the hosted alternative: POST /api/v1/rerank, no weights and no
# cold start, in exchange for a round trip and a shared quota. Its model id must
# end in `:free` and is checked at boot. To use it:
#
#   RETRIEVAL_RERANKER=openrouter
#   RETRIEVAL_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free
#
# ITS SCORES ARE ON A DIFFERENT SCALE and the code accounts for it: `local`
# returns raw logits with the relevant/irrelevant boundary at 0, the hosted one
# returns a probability in (0, 1) where a floor of 0 would admit everything.
# Each implementation carries its own floor. Do not set one by hand.
#
# Free rerankers, live:
#   https://openrouter.ai/api/v1/models?output_modalities=rerank
RETRIEVAL_RERANKER=local
RETRIEVAL_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Multi-turn query rewriting: `off` or `on`. Turns "what about the second
# one?" into a standalone query before retrieval, at the cost of one extra
# model round trip per turn. Still OFF by default: the eval question set is
# single-turn, so nothing has measured it yet and it stays unproven.
RETRIEVAL_QUERY_REWRITE=off

# --- Ingestion ----------------------------------------------------------
# Shared secret for the ingestion route. The pipeline re-invokes itself over
# HTTP when a document needs more than one function invocation, so that route
# is internet-reachable and carries no session. Generate with:
#   openssl rand -base64 32
INGEST_SECRET=

# --- Embeddings ---------------------------------------------------------
# `local` runs the model inside this Node process via Transformers.js: no API
# call, no key, no per-token cost. The weights download once and are cached on
# disk, so the first embed after a cold start is slow and the rest are not.
#
# `openrouter` is the hosted alternative: POST /api/v1/embeddings, no weights
# and no cold start, in exchange for a round trip per batch and a shared quota.
# Its model id must end in `:free`, checked at boot — ingestion embeds every
# chunk of every upload, so a metered embedder is a bill per document rather
# than per question. To use it:
#
#   EMBEDDING_PROVIDER=openrouter
#   EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
#   EMBEDDING_DIMENSIONS=2048
#   QDRANT_COLLECTION=marginalia_chunks_nemotron_2048
#
# NOTE THE LAST TWO LINES. These models are not 384-dimensional, so switching
# means a NEW COLLECTION and a re-ingest of every document — not a config edit.
# Embedding spaces are never mixed: a document records the model and dimension
# it was embedded with, and a search across two spaces is refused rather than
# silently wrong. Pointing a 2048-d provider at a 384-d collection is rejected
# by Qdrant per point, halfway through the first document.
#
# Free embedding models, live:
#   https://openrouter.ai/api/v1/models?output_modalities=embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# Where the model weights are cached. Leave blank to use sensible defaults:
# node_modules in development, /tmp on Vercel (the only writable path in a
# function, reused for the life of a warm instance).
#
# First run downloads ~34 MB from the Hugging Face CDN — the quantised ONNX
# weights plus the tokenizer — and is slow. Every run after that is local.
TRANSFORMERS_CACHE_DIR=

# --- Demo account -------------------------------------------------------
# The one-click demo at /demo signs visitors in as a shared, pre-seeded
# account. This password is PUBLISHED, not secret — the route hands out a
# session for it to anyone who asks, and that is the point.
#
# It is only safe because of what the account cannot do: no uploads, no
# deletes, and a lower daily question cap (see src/lib/demo.ts). Everything a
# visitor can do to that workspace is undone by `npm run db:reset-demo`.
#
# The account's EMAIL is not configurable — it is a constant in
# src/lib/demo.ts alongside the fixed user id, because the seed script, the
# /demo route, and every server-side guard all have to agree on it.
#
# Leave blank to run without a demo: /demo then answers 503 naming the command
# that fixes it, rather than pretending to have one.
DEMO_USER_PASSWORD=demo-marginalia-2026
