# Marginalia — environment
#
# Copy to .env.local and fill in. Every variable here is validated by
# src/lib/env.ts at boot; a missing or malformed value stops the process
# immediately rather than failing on the first request that needs it.

# --- Database -----------------------------------------------------------
# PostgreSQL (Neon). Holds documents, pages, chunk text, the lexical tsvector,
# conversations, messages, citations, retrieval traces, and job state.
# Use the POOLED connection string on serverless.
DATABASE_URL=postgresql://user:password@host.neon.tech/marginalia?sslmode=require

# --- Auth ---------------------------------------------------------------
# Better Auth, email + password. Generate the secret with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Public origin of the app. Inlined into the browser bundle at build time.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- File storage -------------------------------------------------------
# Vercel Blob. Documents are uploaded CLIENT-SIDE with a short-lived token
# minted from this one; file bytes never pass through an API route.
BLOB_READ_WRITE_TOKEN=

# --- Vector store -------------------------------------------------------
# Qdrant Cloud. One collection, cosine distance, dimension taken from the
# embedding config. Payload indexes on user_id and document_id.
QDRANT_URL=https://xxxxxxxx.us-east.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=marginalia_chunks

# --- Model gateway ------------------------------------------------------
# OpenRouter, called through the Vercel AI SDK. Any OpenRouter model slug
# works; see https://openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# --- Embeddings ---------------------------------------------------------
# Behind the EmbeddingProvider interface. Changing EMBEDDING_MODEL means
# re-ingesting every document — embedding spaces are never mixed, and a
# document records the model it was embedded with.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# --- Demo account (optional) -------------------------------------------
# Seeded so a reviewer can sign in without registering. Leave blank to skip.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
