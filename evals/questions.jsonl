# Marginalia eval question set. One JSON object per line; `#` lines and blanks are ignored.
#
# expected_pages is DERIVED, not typed: write the question, name the document, list a few
# verbatim expected_phrases, leave expected_pages empty, then run `npm run eval:pages`.
# It fills in every block that actually contains one of your phrases and fails loudly if a
# phrase is not in the document at all. Hand-typed page numbers go stale the moment the
# corpus is re-fetched; derived ones cannot.
#
# See evals/README.md for how to add a question and what each metric measures.

# ── 45 CFR Part 164 (HIPAA) — breach notification ───────────────────────────────────────
{"id": "hipaa-breach-deadline", "question": "How long does a covered entity have to notify individuals after discovering a breach of unsecured protected health information?", "document": "hipaa-45-cfr-164", "expected_pages": [14, 16], "expected_phrases": ["no case later than 60 calendar days after discovery of a breach"], "answerable": true, "note": "A single number stated once. The easy case: exact, unambiguous, and lexically distinctive."}
{"id": "hipaa-breach-discovered", "question": "When is a breach considered to have been discovered by a covered entity?", "document": "hipaa-45-cfr-164", "expected_pages": [14, 16], "expected_phrases": ["first day on which such breach is known to the covered entity", "by exercising reasonable diligence would have been known"], "answerable": true}
{"id": "hipaa-media-threshold", "question": "At what size does a breach require notifying prominent media outlets?", "document": "hipaa-45-cfr-164", "expected_pages": [15], "expected_phrases": ["more than 500 residents of a State or jurisdiction"], "answerable": true}
{"id": "hipaa-small-breach-log", "question": "How are breaches affecting fewer than 500 individuals reported to the Secretary?", "document": "hipaa-45-cfr-164", "expected_pages": [16], "expected_phrases": ["maintain a log or other documentation of such breaches", "not later than 60 days after the end of each calendar year"], "answerable": true, "note": "Two 60-day deadlines exist in this part and they mean different things. A retrieval system that finds the individual-notification deadline instead has failed in a way the answer will look correct."}
{"id": "hipaa-substitute-notice", "question": "If a covered entity has out-of-date contact details for more than ten affected people, how must it give substitute notice?", "document": "hipaa-45-cfr-164", "expected_pages": [15], "expected_phrases": ["conspicuous posting for a period of 90 days on the home page", "toll-free phone number that remains active for at least 90 days"], "answerable": true}
{"id": "hipaa-notification-content", "question": "What has to be in the breach notification sent to an individual?", "document": "hipaa-45-cfr-164", "expected_pages": [14], "expected_phrases": ["A brief description of what happened, including the date of the breach", "Any steps individuals should take to protect themselves"], "answerable": true}

# ── 45 CFR Part 164 (HIPAA) — security safeguards ───────────────────────────────────────
{"id": "hipaa-unique-user-id", "question": "Is unique user identification a required or an addressable implementation specification?", "document": "hipaa-45-cfr-164", "expected_pages": [10], "expected_phrases": ["Unique user identification (Required)"], "answerable": true, "note": "Required vs Addressable is the distinction the whole Security Rule turns on, and both words appear on the same block."}
{"id": "hipaa-automatic-logoff", "question": "What does the automatic logoff specification actually require a system to do?", "document": "hipaa-45-cfr-164", "expected_pages": [10], "expected_phrases": ["terminate an electronic session after a predetermined time of inactivity"], "answerable": true}
{"id": "hipaa-audit-controls", "question": "What are audit controls under the technical safeguards?", "document": "hipaa-45-cfr-164", "expected_pages": [10], "expected_phrases": ["record and examine activity in information systems that contain or use electronic protected health information"], "answerable": true}
{"id": "hipaa-entity-authentication", "question": "What must a covered entity do to confirm that someone requesting access to electronic PHI is who they say they are?", "document": "hipaa-45-cfr-164", "expected_pages": [10], "expected_phrases": ["verify that a person or entity seeking access to electronic protected health information is the one claimed"], "answerable": true}
{"id": "hipaa-transmission-encryption", "question": "Does the Security Rule require encrypting electronic PHI in transit?", "document": "hipaa-45-cfr-164", "expected_pages": [11], "expected_phrases": ["Encryption (Addressable)", "encrypt electronic protected health information whenever deemed appropriate"], "answerable": true, "note": "The honest answer is 'addressable, not required', which the passage supports and a summary would get wrong."}
{"id": "hipaa-documentation-retention", "question": "How long must the required security documentation be retained?", "document": "hipaa-45-cfr-164", "expected_pages": [4, 12], "expected_phrases": ["6 years from the date of its creation or the date when it last was in effect"], "answerable": true}

