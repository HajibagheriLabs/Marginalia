# ── FAR 52.212-4 — standard commercial contract terms ───────────────────────────────────
{"id": "far-risk-of-loss-fob", "question": "When does risk of loss pass to the Government if shipping is f.o.b. origin?", "document": "far-52-212-4", "expected_pages": [4], "expected_phrases": ["Delivery of the supplies to a carrier, if transportation is f.o.b. origin"], "answerable": true}
{"id": "far-taxes-in-price", "question": "Does the contract price include taxes?", "document": "far-52-212-4", "expected_pages": [4], "expected_phrases": ["contract price includes all applicable Federal, State, and local taxes and duties"], "answerable": true, "note": "A one-sentence clause. Short passages are where lexical search earns its place and dense search often does not."}
{"id": "far-termination-convenience", "question": "What does the contractor get paid if the Government terminates the contract for its own convenience?", "document": "far-52-212-4", "expected_pages": [5], "expected_phrases": ["a percentage of the contract price reflecting the percentage of the work performed prior to the notice of termination"], "answerable": true}
{"id": "far-improper-default", "question": "What happens if the Government terminates for default and the termination turns out to be improper?", "document": "far-52-212-4", "expected_pages": [5, 15], "expected_phrases": ["such termination shall be deemed a termination for convenience"], "answerable": true}
{"id": "far-title-transfer", "question": "At what point does title to delivered items transfer to the Government?", "document": "far-52-212-4", "expected_pages": [5], "expected_phrases": ["title to items furnished under this contract shall pass to the Government upon acceptance"], "answerable": true}
{"id": "far-consequential-damages", "question": "Is the contractor liable for consequential damages from a defect in an accepted item?", "document": "far-52-212-4", "expected_pages": [5], "expected_phrases": ["will not be liable to the Government for consequential damages resulting from any defect"], "answerable": true}
{"id": "far-order-of-precedence", "question": "If the contract documents contradict each other, which one wins?", "document": "far-52-212-4", "expected_pages": [6], "expected_phrases": ["resolved by giving precedence in the following order", "the schedule of supplies/services"], "answerable": true}
{"id": "far-eula-indemnification", "question": "Is an indemnification clause in a click-through licence enforceable against the Government?", "document": "far-52-212-4", "expected_pages": [6], "expected_phrases": ["Any such clause is unenforceable against the Government"], "answerable": true, "note": "The question uses 'click-through' and the clause says 'click-wrap'; the dense channel has to bridge that and the lexical channel cannot."}
{"id": "far-excusable-delays", "question": "What kinds of events excuse the contractor from a default?", "document": "far-52-212-4", "expected_pages": [2], "expected_phrases": ["acts of God or the public enemy", "fires, floods, epidemics, quarantine restrictions, strikes, unusually severe weather"], "answerable": true}
{"id": "far-invoice-tin", "question": "When does an invoice have to carry the contractor's Taxpayer Identification Number?", "document": "far-52-212-4", "expected_pages": [2], "expected_phrases": ["shall include its TIN on the invoice only if required elsewhere in this contract"], "answerable": true}

