{"id": "hipaa-right-of-access", "question": "What does an individual have the right to see in their own records?", "document": "hipaa-45-cfr-164", "expected_pages": [73], "expected_phrases": ["right of access to inspect and obtain a copy of protected health information about the individual in a designated record set"], "answerable": true}
