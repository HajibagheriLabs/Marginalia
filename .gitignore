# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/
/build

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# env files — never commit secrets; .env.example is the tracked template
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local working notes, not part of the repository
/PLAYBOOK2.md

# generated by scripts/copy-pdf-worker.mjs on predev/prebuild, from the pinned
# pdfjs-dist. Committing it would be a second copy of a dependency that can
# then disagree with the first.
/public/pdfjs/

# eval harness
# Result JSON files ARE committed — they are the record a `--compare` diffs
# against. The ingest cache is not: it holds database row ids for one machine's
# eval tenant, and a committed copy would point every other clone at rows that
# do not exist there.
/evals/results/.ingest-cache.json
